<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- SDK 构建目录：默认视觉版（build_tdc），音频版传 -p:ModelDeploySdkDir=build_audio -->
        <ModelDeploySdkDir Condition="'$(ModelDeploySdkDir)'==''">build_tdc</ModelDeploySdkDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="NUnit" Version="4.2.2"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.4.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ModelDeploy\ModelDeploy.csproj" />
    </ItemGroup>

    <Target Name="CopySDKDll" AfterTargets="Build">
        <!-- capi SDK（目录由 ModelDeploySdkDir 指定，默认 build_tdc 视觉版） -->
        <Copy SourceFiles="..\..\$(ModelDeploySdkDir)\bin\ModelDeploySDK.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"/>
<!-- SDK 已改用 mbedTLS（静态链接）做模型加密，不再依赖 OpenSSL；libcrypto DLL 拷贝已废弃。
     CS_OSSL_DLL_NOTE: 若需回退旧 SDK，可取消下行注释恢复 OpenSSL 运行时 DLL 拷贝。 -->
<!-- <Copy SourceFiles="E:\vcpkg\installed\x64-windows\bin\libcrypto-3-x64.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('E:\vcpkg\installed\x64-windows\bin\libcrypto-3-x64.dll')"/> -->
    </Target>

</Project>
